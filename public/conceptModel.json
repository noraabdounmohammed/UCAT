  "concepts": [
    {
      "concept_id": "cv_acs_stemi_dx",
      "title": "STEMI Diagnosis",
      "description": "Diagnosis of ST-elevation Myocardial Infarction",
      "tags": [
        "acute",
        "emergency",
        "ECG"
      ],
      "dimensions": {
        "domain": "Medicine",
        "subject": "Cardiovascular",
        "topic": "Acute Coronary Syndrome",
        "subtopic": "ST-elevation Myocardial Infarction",
        "exam_specific": {
          "ukmla": {
            "systems": [
              "Cardiovascular"
            ],
            "conditions": [
              "ST-elevation Myocardial Infarction",
              "Acute Coronary Syndrome"
            ],
            "presentations": [
              "Chest pain",
              "Left arm radiation",
              "Acute onset",
              "Cardiovascular risk factors"
            ],
            "competencies": [
              "Diagnosis"
            ]
          }
        }
      },
      "knowledge": {
        "decision_rule": "ST-segment elevation in contiguous anterior leads (V1-V4) with typical anginal pain and cardiovascular risk factors is diagnostic of anterior wall STEMI requiring urgent reperfusion.",
        "guideline_ref": {
          "name": "NICE NG185",
          "year": 2020,
          "key_line": "Offer coronary angiography with primary PCI within 120 minutes of first medical contact for people with STEMI presenting within 12 hours of symptom onset."
        },
        "misconceptions": [
          "Stable angina causes ST elevation on ECG",
          "Pericarditis typically presents with unilateral arm pain",
          "Aortic dissection commonly causes anterior ST elevation",
          "Pulmonary embolism presents with ST elevation rather than right heart strain"
        ]
      },
      "difficulty": "medium",
      "linked_questions": [
        "ukmla-akt-gen-001"
      ],
      "mastery_data": {
