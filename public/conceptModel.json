    {
      "concept_id": "cv_acs_nstemi_dx",
      "title": "NSTEMI Diagnosis",
      "description": "Diagnosis of Non-ST-elevation Myocardial Infarction",
      "tags": [
        "acute",
        "emergency",
        "ECG",
        "troponin"
      ],
      "dimensions": {
        "domain": "Medicine",
        "subject": "Cardiovascular",
        "topic": "Acute Coronary Syndrome",
        "subtopic": "Non-ST-elevation Myocardial Infarction",
        "exam_specific": {
          "ukmla": {
            "systems": [
              "Cardiovascular"
            ],
            "conditions": [
              "Non-ST-elevation Myocardial Infarction",
              "Acute Coronary Syndrome"
            ],
            "presentations": [
              "Chest pain",
              "Dyspnea",
              "Diaphoresis",
              "Nausea"
            ],
            "competencies": [
              "Diagnosis"
            ]
          }
        }
      },
      "knowledge": {
        "decision_rule": "Elevated cardiac troponins with ischemic symptoms but without ST-segment elevation is diagnostic of NSTEMI.",
        "guideline_ref": {
          "name": "NICE NG185",
          "year": 2020,
          "key_line": "Offer coronary angiography within 72 hours of first admission for people with NSTEMI or unstable angina."
        },
        "misconceptions": [
          "NSTEMI always presents with less severe symptoms than STEMI",
          "NSTEMI has better long-term outcomes than STEMI",
          "Troponin elevation is always due to ACS",
          "NSTEMI doesn't require urgent intervention"
        ]
      },
      "difficulty": "medium",
