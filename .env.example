VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_URL=your-supabase-url-here

# Server-only AI credentials (configure in Netlify; never prefix secrets with VITE_)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional server-side image and voice generation
OPENAI_IMAGE_KEY=your-openai-api-key-here
OPENAI_AUDIO_KEY=your-openai-api-key-here

# Server-only database access for administrative scripts/functions
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
